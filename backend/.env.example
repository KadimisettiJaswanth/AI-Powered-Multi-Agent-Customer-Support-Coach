# Copy this file to .env and fill in real values for production.
# Every value below has a safe local default in config.py, so the app
# runs with NO .env file at all for local testing.

ENV=local

# --- Database ---
# Local default (no setup needed): sqlite:///./local_app.db
# Production Postgres example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/support_ai
DATABASE_URL=sqlite:///./local_app.db

# --- LLM Provider ---
# "mock" (default, no key needed) | "gemini" | "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
